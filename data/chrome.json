        { "keys": ["Ctrl", "0"], "command": "Reset Zoom", "category": "视图", "description": "重置缩放" },
        { "keys": ["F11"], "command": "Toggle Full Screen", "category": "视图", "description": "切换全屏" },
        { "keys": ["Ctrl", "Shift", "I"], "command": "Developer Tools", "category": "开发者", "description": "打开开发者工具" },
        { "keys": ["Ctrl", "N"], "command": "New Window", "category": "窗口", "description": "打开新窗口" },
        { "keys": ["Ctrl", "Shift", "N"], "command": "New Incognito Window", "category": "窗口", "description": "打开无痕窗口" }
